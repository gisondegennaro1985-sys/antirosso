// Stato dell'applicazione
const defaultState = {
  salary: 0,
  fixedExpenses: 0,
  piggyBank: 0,
  expenses: [], // Array di { id, date, amount, type: 'debit'|'credit' }
  lastCalculatedDate: new Date().toISOString().split('T')[0]
};

let appState = JSON.parse(localStorage.getItem('antirosso_state')) || defaultState;

// Inizializzazione
document.addEventListener('DOMContentLoaded', () => {
  initApp();
  setupEventListeners();
});

function saveState() {
  localStorage.setItem('antirosso_state', JSON.stringify(appState));
}

function initApp() {
  checkDateRollover();
  updateUI();
}

// Gestione del ciclo dal 23 al 22
function getCycleDates(referenceDate = new Date()) {
  const year = referenceDate.getFullYear();
  const month = referenceDate.getMonth();
  const day = referenceDate.getDate();

  let startDate, endDate;

  if (day >= 23) {
    startDate = new Date(year, month, 23);
    endDate = new Date(year, month + 1, 22);
  } else {
    startDate = new Date(year, month - 1, 23);
    endDate = new Date(year, month, 22);
  }

  return { startDate, endDate };
}

function getDaysRemaining() {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const { endDate } = getCycleDates(today);
  endDate.setHours(23, 59, 59, 999);

  const diffTime = endDate - today;
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return Math.max(diffDays, 1);
}

// Verifica passaggio del giorno per gestione Salvadanaio
function checkDateRollover() {
  const todayStr = new Date().toISOString().split('T')[0];
  if (appState.lastCalculatedDate && appState.lastCalculatedDate !== todayStr) {
    const lastDate = new Date(appState.lastCalculatedDate);
    const today = new Date();
    
    // Se è passato almeno un giorno
    if (today > lastDate) {
      const yesterdaySpent = getExpensesForDate(appState.lastCalculatedDate);
      const prevDailyBudget = calculateDailyBudgetForDate(appState.lastCalculatedDate);
      const remainingYesterday = prevDailyBudget - yesterdaySpent;

      if (remainingYesterday > 0) {
        appState.piggyBank += remainingYesterday;
      }
      appState.lastCalculatedDate = todayStr;
      saveState();
    }
  }
}

function getExpensesForDate(dateStr) {
  return appState.expenses
    .filter(e => e.date === dateStr && e.type === 'debit')
    .reduce((sum, e) => sum + e.amount, 0);
}

function calculateDailyBudgetForDate(dateStr) {
  const baseMonthlyFund = appState.salary - appState.fixedExpenses;
  const creditCardSpent = appState.expenses
    .filter(e => e.type === 'credit')
    .reduce((sum, e) => sum + e.amount, 0);
  
  const debitSpentBefore = appState.expenses
    .filter(e => e.type === 'debit' && e.date < dateStr)
    .reduce((sum, e) => sum + e.amount, 0);

  const availableFund = baseMonthlyFund - creditCardSpent - debitSpentBefore;
  const days = getDaysRemaining();
  return days > 0 ? availableFund / days : 0;
}

// Calcolo Budget di Oggi
function calculateCurrentDailyBudget() {
  const baseMonthlyFund = appState.salary - appState.fixedExpenses;
  
  // Carte di credito sottratte subito dal fondo totale
  const creditCardSpent = appState.expenses
    .filter(e => e.type === 'credit')
    .reduce((sum, e) => sum + e.amount, 0);

  // Spese bancomat/contanti passate
  const todayStr = new Date().toISOString().split('T')[0];
  const debitSpentPast = appState.expenses
    .filter(e => e.type === 'debit' && e.date < todayStr)
    .reduce((sum, e) => sum + e.amount, 0);

  // Spese fatte OGGI
  const debitSpentToday = appState.expenses
    .filter(e => e.type === 'debit' && e.date === todayStr)
    .reduce((sum, e) => sum + e.amount, 0);

  const netAvailableFund = baseMonthlyFund - creditCardSpent - debitSpentPast;
  const daysRemaining = getDaysRemaining();
  
  const rawDaily = daysRemaining > 0 ? (netAvailableFund / daysRemaining) : 0;
  return rawDaily - debitSpentToday;
}

function updateUI() {
  const { startDate, endDate } = getCycleDates();
  const options = { day: 'numeric', month: 'short' };
  document.getElementById('cycle-dates').textContent = 
    `Ciclo dal ${startDate.toLocaleDateString('it-IT', options)} al ${endDate.toLocaleDateString('it-IT', options)}`;

  const dailyBudget = calculateCurrentDailyBudget();
  const dailyBudgetElem = document.getElementById('daily-budget');
  dailyBudgetElem.textContent = `€ ${dailyBudget.toFixed(2).replace('.', ',')}`;

  // Semaforo colori
  const heroCard = document.getElementById('hero-card');
  const statusTag = document.getElementById('status-tag');
  
  if (dailyBudget < 0) {
    dailyBudgetElem.style.color = 'var(--status-red)';
    statusTag.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
    statusTag.style.color = 'var(--status-red)';
    statusTag.textContent = 'Budget Superato!';
  } else if (dailyBudget < 10) {
    dailyBudgetElem.style.color = 'var(--status-yellow)';
    statusTag.style.backgroundColor = 'rgba(245, 158, 11, 0.15)';
    statusTag.style.color = 'var(--status-yellow)';
    statusTag.textContent = 'Attenzione al limite';
  } else {
    dailyBudgetElem.style.color = 'var(--status-green)';
    statusTag.style.backgroundColor = 'rgba(16, 185, 129, 0.15)';
    statusTag.style.color = 'var(--status-green)';
    statusTag.textContent = 'In bilancio';
  }

  // Fondo Mese Rimanente
  const baseFund = appState.salary - appState.fixedExpenses;
  const totalSpent = appState.expenses.reduce((sum, e) => sum + e.amount, 0);
  const remainingFund = baseFund - totalSpent;
  document.getElementById('monthly-fund').textContent = `€ ${remainingFund.toFixed(2).replace('.', ',')}`;

  // Giorni Rimanenti
  document.getElementById('days-remaining').textContent = getDaysRemaining();

  // Salvadanaio
  document.getElementById('piggy-amount').textContent = `€ ${appState.piggyBank.toFixed(2).replace('.', ',')}`;

  // Pre-compila form impostazioni se ci sono dati
  if (appState.salary > 0) {
    document.getElementById('salary-amount').value = appState.salary;
  }
  if (appState.fixedExpenses > 0) {
    document.getElementById('fixed-expenses').value = appState.fixedExpenses;
  }
}

function setupEventListeners() {
  // Form Aggiungi Spesa
  document.getElementById('expense-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const amountInput = document.getElementById('expense-amount');
    const amount = parseFloat(amountInput.value);
    const paymentMethod = document.querySelector('input[name="payment-method"]:checked').value;

    if (amount && amount > 0) {
      appState.expenses.push({
        id: Date.now(),
        date: new Date().toISOString().split('T')[0],
        amount: amount,
        type: paymentMethod
      });
      saveState();
      updateUI();
      amountInput.value = '';
    }
  });

  // Form Impostazioni Stipendio
  document.getElementById('salary-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const salary = parseFloat(document.getElementById('salary-amount').value) || 0;
    const fixed = parseFloat(document.getElementById('fixed-expenses').value) || 0;

    appState.salary = salary;
    appState.fixedExpenses = fixed;
    saveState();
    updateUI();
    alert('Parametri aggiornati con successo!');
  });
}
